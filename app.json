{
  "expo": {
    "name": "Checkpoint",
    "slug": "checkpoint-retro-achievements",
    "scheme": "checkpoint",
    "version": "0.1.0",
    "icon": "./assets/checkpoint-medal-512-v2.png",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/checkpoint-medal-512-v2.png"
    },
    "android": {
      "package": "com.nagli.checkpoint",
      "adaptiveIcon": {
        "foregroundImage": "./assets/checkpoint-medal-512-v2.png",
        "backgroundColor": "#071033"
      }
    },
    "plugins": [
      "expo-asset",
      "expo-localization",
      "expo-secure-store",
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "955a056b-1de1-42fe-bfd2-ffb05da34a5f"
      }
    }
  }
}
