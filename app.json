{
  "expo": {
    "name": "Checkpoint",
    "slug": "checkpoint-retro-achievements",
    "scheme": "checkpoint",
    "version": "0.1.0",
    "icon": "./assets/checkpoint-icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/checkpoint-icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/checkpoint-icon.png",
        "backgroundColor": "#071033"
      }
    },
    "plugins": [
      "expo-asset",
      "expo-localization",
      "expo-secure-store"
    ]
  }
}
